# ---------------------------------------------------------------------------
# Thomas Zanitti — Avocat — Variables d'environnement
# Copiez ce fichier en `.env.local` puis complétez les valeurs.
# Aucun secret ne doit être committé sur GitHub.
# ---------------------------------------------------------------------------

# Endpoint du formulaire Formspree (obligatoire pour que le QCM envoie vraiment
# les demandes vers thomas.zanitti-avocat@outlook.fr).
# Création : https://formspree.io/forms (créer un formulaire, puis "Email" =
# thomas.zanitti-avocat@outlook.fr). Vous obtenez une URL du type
# https://formspree.io/f/xxxxxx — collez-la ici telle quelle.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# URL publique du site (utilisée pour les meta Open Graph). Mettre l'URL Vercel
# finale une fois déployé, ex : https://thomas-zanitti-avocat.vercel.app
NEXT_PUBLIC_SITE_URL=